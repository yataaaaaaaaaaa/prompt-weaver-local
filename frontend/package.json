{
	"name": "prompt-weaver-local-frontend",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"main": "electron/main.cjs",
	"scripts": {
		"dev": "vite",
		"build": "tsc -b && vite build",
		"preview": "vite preview",
		"electron:dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
		"electron:start": "electron .",
		"test:unit": "tsc -p tsconfig.tests.json && node --test ../.test-build/tests/promptEngine.test.js"
	},
	"dependencies": {
		"react": "^18.3.1",
		"react-dom": "^18.3.1",
		"zustand": "^5.0.12"
	},
	"devDependencies": {
		"@types/react": "^18.3.12",
		"@types/react-dom": "^18.3.1",
		"@vitejs/plugin-react": "^6.0.1",
		"concurrently": "^9.0.1",
		"cross-env": "^7.0.3",
		"electron": "^42.0.0",
		"typescript": "^5.6.3",
		"vite": "^8.0.10",
		"wait-on": "^8.0.1"
	},
	"overrides": {
		"global-agent": "4.1.3"
	}
}
