{
	"name": "prompt-weaver-local-frontend",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"main": "electron/main.cjs",
	"scripts": {
		"dev": "vite",
		"build": "tsc -b && vite build",
		"preview": "vite preview",
		"electron:start": "electron .",
		"test": "vitest run",
		"test:watch": "vitest",
		"typecheck": "tsc -b",
		"gen:api": "node scripts/generate-api-types.mjs",
		"test:e2e": "playwright test",
		"test:e2e:update": "playwright test --update-snapshots",
		"test:e2e:electron": "playwright test --config playwright.electron.config.ts"
	},
	"dependencies": {
		"@fluentui/react-components": "^9.75.3",
		"@fluentui/react-icons": "^2.0.347",
		"@fluentui/react-theme": "^9.2.3",
		"openapi-fetch": "^0.17.0",
		"react": "^18.3.1",
		"react-dom": "^18.3.1",
		"zustand": "^5.0.12"
	},
	"devDependencies": {
		"@playwright/test": "^1.65.1",
		"@testing-library/dom": "^10.4.2",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/react": "^16.3.3",
		"@testing-library/user-event": "^14.6.13",
		"@types/node": "^24.19.2",
		"@types/pngjs": "^6.0.5",
		"@types/react": "^18.3.12",
		"@types/react-dom": "^18.3.1",
		"@vitejs/plugin-react": "^6.0.1",
		"electron": "^42.0.0",
		"jsdom": "^27.4.0",
		"openapi-typescript": "^7.13.0",
		"pngjs": "^7.0.0",
		"typescript": "^5.6.3",
		"vite": "^8.0.10",
		"vitest": "^5.1.1"
	},
	"overrides": {
		"global-agent": "4.1.3"
	}
}
