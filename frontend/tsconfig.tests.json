{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "lib": ["ES2020", "DOM"],
    "strict": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "outDir": "../.test-build"
  },
  "include": [
    "src/promptEngine.ts",
    "src/utils.ts",
    "src/types.ts",
    "src/api.ts",
    "src/app/appHelpers.ts",
    "src/app/appTypes.ts",
    "tests/**/*.ts"
  ]
}
