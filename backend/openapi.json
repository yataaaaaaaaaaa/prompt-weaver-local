        "description": "zustand persist envelope: the partialized store state plus its schema version.",
        "properties": {
          "state": {
            "additionalProperties": true,
            "title": "State",
            "type": "object"
          },
          "version": {
            "default": 0,
            "title": "Version",
            "type": "integer"
          }
        },
        "required": [
          "state",
          "version"
        ],
        "title": "PersistedStoreEnvelope",
        "type": "object"
      },
      "PersistedStoreRead": {
        "properties": {
          "envelope": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/PersistedStoreEnvelope-Output"
              },
              {
                "type": "null"
              }
            ]
          },
          "name": {
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "name",
          "envelope"
        ],
        "title": "PersistedStoreRead",
        "type": "object"
      },
      "PromptCategory": {
        "properties": {
          "activation_text": {
            "default": "",
            "title": "Activation Text",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "locked_prompt_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Locked Prompt Id"
          },
          "locked_prompt_text": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Locked Prompt Text"
          },
          "muted": {
            "default": false,
            "title": "Muted",
            "type": "boolean"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "position": {
            "$ref": "#/components/schemas/CategoryPosition"
          },
          "priority": {
            "default": "1",
            "title": "Priority",
            "type": "string"
          },
          "prompts": {
            "items": {
              "$ref": "#/components/schemas/PromptEntry"
            },
            "title": "Prompts",
            "type": "array"
          },
          "size": {
            "$ref": "#/components/schemas/CategorySize"
          },
          "z_index": {
            "default": 50,
            "title": "Z Index",
            "type": "integer"
          }
        },
        "required": [
          "id",
          "name",
          "muted",
          "priority",
          "activation_text",
          "locked_prompt_id",
          "locked_prompt_text",
          "position",
          "size",
          "z_index",
          "prompts"
        ],
        "title": "PromptCategory",
        "type": "object"
      },
      "PromptEntry": {
        "properties": {
          "extra_lora_ids": {
            "items": {
              "type": "string"
            },
            "title": "Extra Lora Ids",
            "type": "array"
          },
          "id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Id"
          },
          "skipped": {
            "default": false,
            "title": "Skipped",
            "type": "boolean"
          },
          "text": {
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "id",
          "text",
          "skipped",
          "extra_lora_ids"
        ],
        "title": "PromptEntry",
        "type": "object"
      },
      "TaskSnapshot": {
        "description": "Latest event of every known task. The WebSocket sends these events on connect.",
        "properties": {
          "events": {
            "items": {
              "discriminator": {
                "mapping": {
                  "download": "#/components/schemas/DownloadTaskEvent",
                  "generation": "#/components/schemas/GenerationTaskEvent"
                },
                "propertyName": "type"
              },
              "oneOf": [
                {
                  "$ref": "#/components/schemas/GenerationTaskEvent"
                },
                {
                  "$ref": "#/components/schemas/DownloadTaskEvent"
                }
              ]
            },
            "title": "Events",
            "type": "array"
          }
        },
        "required": [
          "events"
        ],
        "title": "TaskSnapshot",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      },
      "WorkspaceLayout": {
        "properties": {
          "controls": {
            "$ref": "#/components/schemas/PaneLayout"
          },
          "details": {
            "$ref": "#/components/schemas/PaneLayout"
          },
          "image": {
            "$ref": "#/components/schemas/PaneLayout"
          },
          "used": {
            "$ref": "#/components/schemas/PaneLayout"
          }
        },
        "required": [
          "image",
          "controls",
          "details",
          "used"
        ],
        "title": "WorkspaceLayout",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Prompt Weaver Local",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/bootstrap": {
      "get": {
        "description": "Everything the frontend needs at startup (see BootstrapResponse field docs).",
        "operationId": "bootstrap_api_bootstrap_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BootstrapResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Bootstrap",
        "tags": [
          "bootstrap"
        ]
      }
    },
    "/api/generate": {
      "post": {
        "description": "Generate one image, save it as the next output and return its metadata.\nProgress is published as GenerationTaskEvent on /ws/tasks.",
        "operationId": "generate_api_generate_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GenerateRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OutputRecord"
                }
              }
            },
            "description": "Successful Response"
          },
          "409": {
            "description": "Generation failed or was cancelled"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Generate",
        "tags": [
          "generation"
        ]
      }
    },
    "/api/generate/cancel": {
      "post": {
        "operationId": "cancel_generate_api_generate_cancel_post",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OkResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Cancel Generate",
        "tags": [
          "generation"
        ]
      }
    },
    "/api/health": {
      "get": {
        "operationId": "health_api_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health",
        "tags": [
          "health"
        ]
      }
    },
    "/api/outputs": {
      "get": {
        "operationId": "list_outputs_api_outputs_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OutputIndex"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "List Outputs",
        "tags": [
          "outputs"
        ]
      }
    },
    "/api/outputs/{output_id}": {
      "get": {
        "operationId": "get_output_api_outputs__output_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "output_id",
            "required": true,
            "schema": {
              "pattern": "^\\d{10}$",
              "title": "Output Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OutputRecord"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "description": "Unknown output"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Output",
        "tags": [
          "outputs"
        ]
      }
    },
    "/api/outputs/{output_id}/image": {
      "get": {
        "operationId": "get_output_image_api_outputs__output_id__image_get",
        "parameters": [
          {
            "in": "path",
            "name": "output_id",
            "required": true,
            "schema": {
              "pattern": "^\\d{10}$",
              "title": "Output Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "image/png": {}
            },
            "description": "Successful Response"
          },
          "404": {
            "description": "Unknown output"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Output Image",
        "tags": [
          "outputs"
        ]
      }
    },
    "/api/outputs/{output_id}/trash": {
      "post": {
        "description": "Move the output (png + json) into the app-managed trash.",
        "operationId": "trash_output_api_outputs__output_id__trash_post",
        "parameters": [
          {
            "in": "path",
            "name": "output_id",
            "required": true,
            "schema": {
              "pattern": "^\\d{10}$",
              "title": "Output Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OkResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "description": "Unknown output"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Trash Output",
        "tags": [
          "outputs"
        ]
      }
    },
    "/api/stores/{name}": {
      "delete": {
        "operationId": "delete_store_api_stores__name__delete",
        "parameters": [
          {
            "in": "path",
            "name": "name",
            "required": true,
            "schema": {
              "pattern": "^[a-z0-9][a-z0-9-]{0,63}$",
              "title": "Name",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OkResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Delete Store",
        "tags": [
          "stores"
        ]
      },
      "get": {
        "description": "Persisted state of one frontend store (envelope is null when nothing was persisted yet).",
        "operationId": "read_store_api_stores__name__get",
        "parameters": [
          {
            "in": "path",
            "name": "name",
            "required": true,
            "schema": {
              "pattern": "^[a-z0-9][a-z0-9-]{0,63}$",
              "title": "Name",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PersistedStoreRead"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Read Store",
        "tags": [
          "stores"
        ]
      },
      "put": {
        "operationId": "write_store_api_stores__name__put",
        "parameters": [
          {
            "in": "path",
            "name": "name",
            "required": true,
            "schema": {
              "pattern": "^[a-z0-9][a-z0-9-]{0,63}$",
              "title": "Name",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PersistedStoreEnvelope-Input"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OkResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Write Store",
        "tags": [
          "stores"
        ]
      }
    },
    "/api/tasks": {
      "get": {
        "description": "Latest event of every known background task.",
        "operationId": "get_tasks_api_tasks_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TaskSnapshot"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Get Tasks",
        "tags": [
          "tasks"
        ]
      }
    },
    "/api/trash/{output_id}/restore": {
      "post": {
        "description": "Move a trashed output back into the output folder (undo of delete).",
        "operationId": "restore_output_api_trash__output_id__restore_post",
        "parameters": [
          {
            "in": "path",
            "name": "output_id",
            "required": true,
            "schema": {
              "pattern": "^\\d{10}$",
              "title": "Output Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OkResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "description": "Not in trash"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Restore Output",
        "tags": [
          "outputs"
        ]
      }
    }
  }
}
